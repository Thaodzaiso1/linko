# Oracle 23ai PDB account with minimum grants
DB_USER=SOCIAL_NETWORK
DB_PASSWORD=replace_with_secure_database_password
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_INCREMENT=1
DB_POOL_WAIT_TIMEOUT=10000
APP_LOG_LEVEL=INFO

# IMPORTANT: V7 FAILS CLOSED unless authentication is properly configured.
# Local/demo: issue tokens with tools/issue_demo_token.py. Never share secret with frontend.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_MODE=local
JWT_SECRET=

# Enterprise production: AUTH_MODE=oidc, trusted external SSO/IdP signs RS256 JWT
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Never use test bypass outside automated tests.
ENVIRONMENT=development
ALLOW_TEST_AUTH_BYPASS=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
